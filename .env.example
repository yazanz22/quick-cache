# Copy this file to .env (same folder) and fill in your own keys. .env is gitignored.
LLM_PROVIDER=gemini              # gemini | groq | anthropic
LLM_FALLBACK_PROVIDER=groq       # optional, used on rate-limit errors
GEMINI_API_KEY=                  # free from https://aistudio.google.com/apikey
GROQ_API_KEY=                    # free from https://console.groq.com/keys
ANTHROPIC_API_KEY=               # optional, paid
MODEL_FAST=gemini-3.5-flash         # tested on free tier 2026-10-09 (3.8-flash was 503 busy; 2.5-flash closed to new keys)
MODEL_SMART=gemini-3.5-flash
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_SMART=openai/gpt-oss-120b
LLM_TIMEOUT_S=15
DEMO_OFFLINE=0                   # 1 = cache + fallbacks only (no internet)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OFFLINE_MAP=0        # 1 = no map tiles, draw areas.geojson instead
